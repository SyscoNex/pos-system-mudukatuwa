# ASP.NET reads actual environment variables, not this example automatically.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5180
AllowedHosts=localhost;127.0.0.1
# Production: HTTPS reverse proxy, explicit host/trusted-proxy configuration.
# Default no-database foundation mode remains available.
Authentication__Enabled=false
Database__Enabled=false
Operations__Enabled=false
# For authorized local auth review use infrastructure/compose.auth-review.yaml.
# Production overrides (paths only; never put real secrets in this tracked file):
# Authentication__Enabled=true
# Authentication__AllowedOrigins__0=https://your-approved-host
# Database__Enabled=true
# Database__ConnectionFile=/run/secrets/runtime_connection
# Storage__KeyDirectory=/data/keys
# Storage__LogoDirectory=/data/logos
# Storage__CertificateFile=/run/secrets/dp_certificate
# Storage__CertificatePasswordFile=/run/secrets/dp_password
# Proxy__KnownProxies__0=<exact trusted TLS reverse-proxy IP>
# MySQL production connection file must use SSL Mode=VerifyFull with its trusted CA.
# Migration credentials are supplied only to an explicitly approved admin command.
