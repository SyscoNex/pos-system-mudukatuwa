{
  "name": "conex360-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11.20.0 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3600",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "1.79.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "typescript-eslint": "8.74.0",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
